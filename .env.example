# RunningPlans server-side configuration
# Add these in Vercel Project Settings > Environment Variables.

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Use a long random value (at least 24 characters). This encrypts/signs the short-lived Strava session.
SESSION_SECRET=

# Optional but recommended. Without this, the report falls back to deterministic copy.
OPENAI_API_KEY=
OPENAI_REPORT_MODEL=gpt-6-luna

# Keep false/omit in production until Payhip is connected.
# Set true only while testing your own end-to-end report generation.
REPORT_TEST_MODE=false

# Production Vercel URL or custom domain, with no trailing slash.
# Example: https://runningplans.co.uk
PUBLIC_BASE_URL=

# Payhip integration will be added next.
# PAYHIP_PRODUCT_KEY=
# PAYHIP_WEBHOOK_SECRET=
